# EVIDENCE — environment variables
# Copy to .env and fill in real values. Never commit .env.

# Database
DATABASE_URL=postgres://evidence:evidence@localhost:5432/evidence

# API
API_PORT=3000
API_HOST=0.0.0.0
LOG_LEVEL=info

# Webhook signing (per-source HMAC secret used in dev)
WEBHOOK_HMAC_SECRET=change-me-in-prod
