# EVIDENCE — environment variables
# Copy to .env and fill in real values. Never commit .env.

# ---- Database ----
DATABASE_URL=postgres://evidence:evidence@localhost:5432/evidence

# ---- API ----
API_PORT=3000
API_HOST=0.0.0.0
LOG_LEVEL=info

# Webhook signing (per-source HMAC secret used in dev)
WEBHOOK_HMAC_SECRET=change-me-in-prod

# ---- Evidence storage ----
# local: writes to STORAGE_LOCAL_DIR with simulated immutability (dev/test)
# s3:    AWS S3 with Object Lock + KMS-SSE (production)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./.evidence-store
# STORAGE_S3_BUCKET=evidence-prod
# STORAGE_S3_REGION=sa-east-1
# STORAGE_KMS_KEY_ID=alias/evidence

# Retention policy applied to every new evidence object.
# - compliance: immutable until retain_until, even for root
# - governance: privileged users can override (use in staging)
# - none:       no retention lock (dev only)
RETAIN_MODE=governance
RETAIN_YEARS=5

# ---- TSA providers ----
# mock        — deterministic in-memory, no network (default for dev/test)
# freetsa     — public RFC 3161 TSA (not legally accredited)
# icp-brasil  — Brazilian ICP-Brasil accredited PSC (stub until credentials)
# eidas       — eIDAS-qualified TSA (stub until credentials)
# us-digicert — US-anchored TSA (stub until credentials)
TSA_DEFAULT_PROVIDER=mock
TSA_BR_PROVIDER=mock
TSA_EU_PROVIDER=mock
TSA_US_PROVIDER=mock
